{
  "name": "personal-archive",
  "version": "0.1.0-alpha.0",
  "description": "Self-hosted documents, reading notes, long writing, and personal vaults.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15.0 <25"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "build:selfhost": "node scripts/build-selfhost.mjs",
    "build:docker": "npm run build && npm run build:selfhost",
    "start:selfhost": "node dist-server/selfhost.mjs",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "node scripts/test.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:bookmarks": "node scripts/test-bookmarks.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:set-password": "node scripts/set-user-password.mjs",
    "db:init-admin": "node scripts/init-admin.mjs"
  },
  "keywords": [
    "personal-archive",
    "self-hosted",
    "documents",
    "postgresql",
    "s3"
  ],
  "author": "Alenwan",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@noble/hashes": "2.3.0",
    "dompurify": "^3.4.13",
    "fflate": "^0.8.3",
    "hono": "^4.13.3",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.9",
    "pinia": "^3.0.4",
    "postgres": "^3.4.9",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "^4.6.2",
    "autoprefixer": "^10.5.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^4.5.14",
    "vue-tsc": "^3.2.7",
    "wrangler": "^4.86.0"
  }
}
