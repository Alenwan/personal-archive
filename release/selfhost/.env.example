# configure.mjs creates a new private .env and fills these values once.
COMPOSE_PROJECT_NAME=''
POSTGRES_PASSWORD=''
CREDENTIAL_ENCRYPTION_KEY=''
MANUSCRIPT_RECOVERY_KEY=''
PRIVATE_VAULT_RECOVERY_KEY=''
# Generated for the bundled single-host Garage option; unused with external S3.
GARAGE_RPC_SECRET=''

# configure.mjs --bundled fills these automatically. For external S3, fill them manually.
# Single quotes preserve literal dollar signs and hashes in credentials.
S3_ENDPOINT=''
S3_REGION='us-east-1'
S3_ACCESS_KEY_ID=''
S3_SECRET_ACCESS_KEY=''
S3_FORCE_PATH_STYLE='true'
DOCUMENT_BUCKET_NAME=''
BACKUP_BUCKET_NAME=''

APP_PORT='8080'
MAX_UPLOAD_MB='250'
